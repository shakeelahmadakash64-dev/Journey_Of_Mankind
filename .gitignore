# Journey of Mankind - Git Ignore Rules

# Critical: Player accounts, progress, and database
mankind_data.db
*.db
*.sqlite
*.sqlite3

# Logs & temporary runtime outputs
error.log
*.log
test_voice.mp3
*.tmp

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Build artifacts & installers (uploaded to GitHub Releases)
build/
dist/
dist_installer/
*.exe
*.spec
*.iss
test_install/
